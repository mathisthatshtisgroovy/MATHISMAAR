<!DOCTYPE html>
<html lang="en">
<head>
<script>
  window.ASSET_BASE = "https://mathismaar.b-cdn.net";
  window.assetUrl = function (u) {
    if (!u) return "";
    if (u.startsWith("http")) return u;
    return window.ASSET_BASE + "/" + u.replace(/^\/+/, "");
  };
  var assetUrl = window.assetUrl;
</script>

<meta charset="UTF-8">
<title>{{ pageTitle or "Mathis Dabbarh Marsepoil" }}</title>
<meta name="description" content="{{ pageDescription or 'Mathis Dabbarh Marsepoil — sonic researcher and artist. Transmission of memory and culture, instruments, installations, field recording, spatial sound.' }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
<meta property="og:title" content="{{ pageTitle or 'Mathis Dabbarh Marsepoil' }}">
<meta property="og:description" content="{{ pageDescription or 'Sonic researcher and artist — MA Geo-Design, Design Academy Eindhoven.' }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="author" content="Mathis Dabbarh Marsepoil">
<meta name="copyright" content="© {% year %} Mathis Dabbarh Marsepoil. All rights reserved.">
<link rel="stylesheet" href="/global.css">
<link rel="stylesheet" href="/archive.css">
<link rel="stylesheet" href="/new.css">
{% block head %}{% endblock %}
</head>

<body data-page="{{ pageKey }}"{% if pageKey == 'home' %} class="transparent-bg"{% endif %}>
{# dark is the default now — only an explicit "0" (user toggled to light) opts out #}
<script>if(localStorage.getItem("mm-dark-mode")!=="0")document.body.classList.add("dark-mode");</script>

{% include "nav.njk" %}

<div class="archive-button" id="archive-button"></div>
<div class="now-playing-wrap">
  <div id="skip-sound" class="skip-sound-btn"></div>
  <div id="now-playing" class="now-playing-text">Now Playing: —</div>
  <div id="skip-notice" class="skip-notice">skipped</div>
</div>

{% block content %}{% endblock %}

<footer class="site-footer">© {% year %} Mathis Dabbarh Marsepoil. All rights reserved.</footer>

<script src="/sound.js"></script>
<script src="/transition.js"></script>
<script>
document.getElementById("archive-button").onclick = ()=> toggleDarkMode();
document.getElementById("skip-sound").onclick = ()=> skipTrack();
resumeSoundIfNeeded();

// pages with a full-bleed photo hero (home, worksingle) force the nav
// white for legibility over the image; once scrolled past it into the
// plain --bg content below, .past-hero hands the nav back to the normal
// theme-aware color (see new.css / work-single.css)
(function () {
  function update() {
    document.body.classList.toggle("past-hero", window.scrollY > window.innerHeight * 0.8);
  }
  update();
  window.addEventListener("scroll", update, { passive: true });
})();

// sequence videos play only when clicked (nothing downloads before that) and
// pause again once scrolled out of view, so nothing runs in the background
(function () {
  document.querySelectorAll(".wb-shot video").forEach(function (v) {
    var shot = v.parentElement;
    var btn = shot.querySelector(".wb-play");
    function toggle() {
      if (v.paused) v.play().catch(function () {});
      else v.pause();
    }
    if (btn) btn.addEventListener("click", toggle);
    v.addEventListener("click", toggle);
    v.addEventListener("play", function () { shot.classList.add("is-playing"); });
    v.addEventListener("pause", function () { shot.classList.remove("is-playing"); });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting && !v.paused) v.pause();
      }).observe(v);
    }
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
