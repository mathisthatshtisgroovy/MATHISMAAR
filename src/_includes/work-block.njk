{# a work on the index scroll: band, then the full image sequence.
   expects: work, linked. `accent` colours this work's 2px seams. #}
<section class="wb" id="{{ work.data.slug }}"{% if work.data.accent %} style="--seam-color: {{ work.data.accent }}"{% endif %}>
  {% include "work-band.njk" %}
  {% set seqImages = work.data.images %}
  {% include "work-seq.njk" %}
</section>
