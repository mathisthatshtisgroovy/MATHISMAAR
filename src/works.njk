---
pagination:
  data: collections.works
  size: 1
  alias: work
permalink: "/works/{{ work.data.slug }}/"
pageKey: worksingle
eleventyComputed:
  pageTitle: "{{ work.data.title }} — Mathis Dabbarh Marsepoil"
  pageDescription: "{{ work.data.abstract }}"
  # the opening frame doubles as the share image — always a file we know exists
  ogImage: "{{ work.data.images[0].src | assetPath('assets/img/') }}"
---
{% extends "base.njk" %}

{% block content %}
{% set neighbors = collections.works | workNeighbors(work.data.slug) %}
<article class="scroll-index">

  {% set linked = false %}
  {% set body = work.templateContent | stripComments | trim %}
  {% set lede = work.data | textImage %}
  {% set useLede = body and lede %}
  {% set seqImages = (work.data.images | withoutSrc(lede.src)) if useLede else work.data.images %}

  <section class="wb" id="{{ work.data.slug }}"{% if work.data.accent %} style="--seam-color: {{ work.data.accent }}"{% endif %}>
    {% include "work-band.njk" %}

    {# only a work with long text (its markdown body) gets the spread, before
       its images: text centred on the left half, one of its images on the
       right (left out of the sequence below if it's in there). no long text:
       nothing — the abstract in the band is never reused here. #}
    {% if useLede %}
    <div class="wb-lede">
      <div class="wb-lede-text">
        <div class="wb-lede-inner">
          {{ body | markdown | safe }}
        </div>
      </div>
      <figure class="wb-lede-image">
        <img src="{{ lede.src | assetPath(lede.folder or 'assets/img/') }}" alt="{{ lede.alt or work.data.title }}"
             fetchpriority="high" decoding="async">
      </figure>
    </div>
    {% elif body %}
    <div class="wb-spread">
      {{ body | markdown | safe }}
    </div>
    {% endif %}

    {% include "work-seq.njk" %}
  </section>

  {% if work.data.exhibitions and work.data.exhibitions.length %}
  <div class="wb-text wb-tail">
    <div class="wb-col wb-col--meta"><span class="wb-label">Exhibitions</span></div>
    <div class="wb-col wb-col--main">
      {% for e in work.data.exhibitions %}
      <span class="wb-exh-row"><span class="wb-exh-year">{{ e.year }}</span>{{ e.title }}{% if e.venue %}, {{ e.venue }}{% endif %}{% if e.city %}, {{ e.city }}{% endif %}</span>
      {% endfor %}
    </div>
    <div class="wb-col wb-col--side"></div>
  </div>
  {% endif %}

  <nav class="wb-text wb-nav">
    <div class="wb-col wb-col--meta"><a href="/works/{{ neighbors.prev.data.slug }}/">← {{ neighbors.prev.data.title }}</a></div>
    <div class="wb-col wb-col--main"><a href="/#works">Index</a></div>
    <div class="wb-col wb-col--side"><a href="/works/{{ neighbors.next.data.slug }}/">{{ neighbors.next.data.title }} →</a></div>
  </nav>

</article>
{% endblock %}
